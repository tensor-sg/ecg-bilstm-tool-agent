# ---------- Vector store (persistent local Chroma) ----------
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=ecg_knowledge

# ---------- LLM (any OpenAI-compatible endpoint: OpenAI, Ollama, vLLM, LM Studio, ...) ----------
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# local  = all-MiniLM-L6-v2 (ONNX, runs on CPU, no key needed; downloaded once)
# openai = any OpenAI-compatible embeddings endpoint (set the three values below)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---------- RAG ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# ---------- ECG model (produced by notebooks/02_lstm_training.ipynb) ----------
ECG_MODEL_PATH=models/ecg_lstm.keras
ECG_META_PATH=models/ecg_lstm_meta.json

# ---------- App ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
