# ---------- Vector store (persistent local Chroma) ----------
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=ecg_knowledge

# ---------- LLM agent ----------
# LLM_PROVIDER: openai  -> uses OPENAI_API_KEY (default model gpt-4o-mini)
#               gemini  -> uses GEMINI_API_KEY via Google's OpenAI-compatible endpoint (default gemini-2.5-flash)
#               custom  -> uses LLM_API_KEY + LLM_BASE_URL (Ollama, vLLM, LM Studio, ...)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional: answer with this provider when the main one fails (bad key, quota, outage). Use "none" to disable.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.5-flash
# Optional: sampling temperature (leave empty for the provider default; some reasoning models reject it)
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
GEMINI_API_KEY=
# Only for LLM_PROVIDER=custom
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1

# ---------- Embeddings ----------
# local  = all-MiniLM-L6-v2 (ONNX, runs on CPU, no key needed; downloaded once)
# openai = OpenAI-compatible embeddings endpoint (EMBEDDING_API_KEY, or OPENAI_API_KEY if empty)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ---------- RAG ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# ---------- ECG model (produced by notebooks/02_lstm_training.ipynb) ----------
ECG_MODEL_PATH=models/ecg_lstm.keras
ECG_META_PATH=models/ecg_lstm_meta.json

# ---------- App ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
